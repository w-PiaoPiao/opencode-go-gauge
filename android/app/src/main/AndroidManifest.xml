<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 应用内下载更新后触发系统安装器 (个人侧载; 需用户在系统设置中授权) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 常驻通知 (v2.2.0b, 设置开关; API 33+ 运行时请求) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".GoGaugeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_blue"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GoGauge">

        <!-- 真正的入口 Activity: 不直接挂 LAUNCHER, 由下方两个 activity-alias 承载
             启动器入口。alias 图标随设置「图标风格」互斥启停 (见 util/LauncherIcon.kt)，
             这样同一时间桌面只出现一个图标。
             exported 保持 true: 桌面通过 alias 拉起时部分 ROM 会按 targetActivity 的
             exported 做二次校验 (此前本 Activity 就带 LAUNCHER 且 exported=true,
             收紧为 false 无收益且有启动失败风险)。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- 启动器图标 alias — 品牌蓝 (默认启用)。
             注意: targetActivity 必须在本文件更早处声明。 -->
        <activity-alias
            android:name=".LauncherBlue"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher_blue"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 启动器图标 alias — 陶土橙 (默认禁用; 选「陶土橙」时与蓝色 alias 互斥切换) -->
        <activity-alias
            android:name=".LauncherTerracotta"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_terracotta"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 配额小组件 (v2.2.0b) -->
        <receiver
            android:name=".widget.QuotaWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quota_widget_info" />
        </receiver>

        <!-- 小组件账号选择配置页 (由桌面 launcher 调起) -->
        <activity
            android:name=".widget.QuotaWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.GoGauge">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 配额快捷磁贴 (QuickSettings) -->
        <service
            android:name=".widget.QuotaTileService"
            android:exported="true"
            android:icon="@drawable/ic_notif"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 更新包目录 (cacheDir/updates) 经 FileProvider 共享给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
