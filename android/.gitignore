# Gradle
.gradle/
build/
.gradle-home/

# Android
local.properties
*.apk
*.aab
captures/

# IDE
.idea/
*.iml
.vscode/

# Keystore: 正式发布密钥不入库 (通过 keystore.properties 指向仓库外路径);
# 仓库内的 debug.keystore 是**刻意提交**的 —— 仅供个人侧载签名, 密钥公开,
# 任何人都能伪造同签名包, 不可用于正式分发 (见 app/build.gradle.kts 的
# gogauge.strictSigning 与 .github/workflows/release-android.yml 的说明).
*.keystore
*.jks
!debug.keystore

# OS
.DS_Store

# Local AVD copy (used only for emulator testing in this workspace)
.avd/
.tmp/

# 仓库根 .gitignore 的 data/ 规则(匹配任意层级)会误伤安卓源码目录,此处取消忽略
!app/src/main/java/io/github/yphyphyph/gogauge/data/
!app/src/test/java/io/github/yphyphyph/gogauge/data/
keystore.properties
