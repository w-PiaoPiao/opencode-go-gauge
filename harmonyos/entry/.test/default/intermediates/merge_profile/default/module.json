{
	"app": {
		"bundleName": "io.github.yphyphyph.gogauge",
		"vendor": "yphyphyph",
		"versionCode": 1000000,
		"versionName": "1.0.0",
		"icon": "$media:icon",
		"label": "$string:app_name",
		"apiReleaseType": "Release",
		"compileSdkVersion": "6.1.1.125",
		"targetAPIVersion": 60101024,
		"minAPIVersion": 60101024,
		"compileSdkType": "HarmonyOS",
		"targetMinorAPIVersion": 0,
		"targetPatchAPIVersion": 0,
		"appEnvironments": [],
		"bundleType": "app",
		"buildMode": "debug",
		"debug": true
	},
	"module": {
		"name": "entry",
		"type": "entry",
		"description": "$string:module_desc",
		"mainElement": "EntryAbility",
		"deviceTypes": [
			"phone",
			"tablet",
			"2in1"
		],
		"deliveryWithInstall": true,
		"installationFree": false,
		"pages": "$profile:main_pages",
		"requestPermissions": [
			{
				"name": "ohos.permission.INTERNET"
			}
		],
		"abilities": [
			{
				"name": "EntryAbility",
				"srcEntry": "./ets/entryability/EntryAbility.ets",
				"description": "$string:ability_desc",
				"icon": "$media:icon",
				"label": "$string:app_name",
				"startWindowIcon": "$media:icon",
				"startWindowBackground": "$color:start_window_background",
				"exported": true,
				"skills": [
					{
						"entities": [
							"entity.system.home"
						],
						"actions": [
							"action.system.home"
						]
					}
				]
			}
		],
		"extensionAbilities": [
			{
				"name": "SyncWorkerAbility",
				"srcEntry": "./ets/entryability/SyncWorkerAbility.ets",
				"description": "$string:sync_worker_desc",
				"type": "workScheduler",
				"exported": false
			}
		],
		"packageName": "entry"
	}
}
