      }
    }
    return resolved
  }

  async setActiveAccount(accountId: number): Promise<boolean> {
    const row = await this.accountRowById(accountId)
    if (row === null) {
      return false
    }
    await this.settings().writeActiveAccountId(accountId)
    return true
  }

