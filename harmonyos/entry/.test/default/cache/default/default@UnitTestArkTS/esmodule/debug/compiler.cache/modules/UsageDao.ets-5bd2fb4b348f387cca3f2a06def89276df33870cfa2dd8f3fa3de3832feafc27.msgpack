urnStatementÍÑÍÚLªIdentifierÍØÍÙ¡tN°MethodDefinitionÍÍ%xÂÂLªIdentifierÍÍ!ªdailyStats¦methodO²FunctionExpressionÍ!Í%xÀÂÂÃ’LªIdentifierÍ"Í&¤daysLªIdentifierÍ(Í1©accountIdM®BlockStatementÍ3Í%x—S³VariableDeclarationÍ>Ío‘T²VariableDeclaratorÍDÍnLªIdentifierÍDÍK§clampedQ®CallExpressionÍNÍnR°MemberExpressionÍNÍVLªIdentifierÍNÍR¤MathLªIdentifierÍSÍV£minÂÂ’W§LiteralÍWÍZÍm£365Q®CallExpressionÍ\ÍmR°MemberExpressionÍ\ÍdLªIdentifierÍ\Í`¤MathLªIdentifierÍaÍd£maxÂÂ’W§LiteralÍeÍf¡1LªIdentifierÍhÍl¤daysÂÂ¥constS³VariableDeclarationÍyÍ!r‘T²VariableDeclaratorÍÍ!qLªIdentifierÍÍ¢rsP¯AwaitExpressionÍ„Í!qQ®CallExpressionÍŠÍ!qR°MemberExpressionÍŠÍŸQ®CallExpressionÍŠÍ–R°MemberExpressionÍŠÍ”\®ThisExpressionÍŠÍLªIdentifierÍÍ”¥storeÂÂÂLªIdentifierÍ—ÍŸ¨querySqlÂÂ’^¯TemplateLiteralÍ Í!D‘_¯TemplateElementÍ¡Í!C`Ú¢SELECT substr(datetime(created_at, 'localtime'), 1, 10) AS date,
              COALESCE(SUM(input_tokens + cache_read_tokens + cache_write_5m_tokens + cache_write_1h_tokens), 0) AS total_input_tokens,
              COALESCE(SUM(input_tokens), 0) AS uncached_input_tokens,
              COALESCE(SUM(reasoning_tokens), 0) AS total_reasoning_tokens,
              COALESCE(SUM(cache_read_tokens), 0) AS cache_hit_tokens,
              COALESCE(SUM(cache_write_5m_tokens + cache_write_1h_tokens), 0) AS cache_write_tokens,
              COALESCE(SUM(output_tokens), 0) AS total_output_tokens,
              COALESCE(SUM(cost_usd), 0) AS total_cost_usd,
              COALESCE(COUNT(*), 0) AS request_count
       FROM usage_records
       WHERE account_id = ? AND substr(datetime(created_at, 'localtime'), 1, 10) >= date('now', 'localtime', ?)
       GROUP BY substr(datetime(created_at, 'localtime'), 1, 10)
       ORDER BY date ASCÚ¢SELECT substr(datetime(created_at, 'localtime'), 1, 10) AS date,
              COALESCE(SUM(input_tokens + cache_read_tokens + cache_write_5m_tokens + cache_write_1h_tokens), 0) AS total_input_tokens,
              COALESCE(SUM(input_tokens), 0) AS uncached_input_tokens,
