                return loggedMin;
            }
            return stored;
        }
    }
    if (loggedMin !== 0) {
        return loggedMin;
    }
    let fallback = 0;
    for (const a of pairs) {
        if (fallback === 0 || a[0] < fallback) {
            fallback = a[0];
