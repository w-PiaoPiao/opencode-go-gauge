            return { ok: false, error: 'å·²æœ‰åŒæ­¥ä»»åŠ¡è¿›è¡Œä¸­', inserted: 0, pages: 0, partial: false, failedPages: 0 };
        }
        const settings = await AppDb.settingsDao().getSettings();
