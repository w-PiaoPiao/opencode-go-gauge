            }
            const msg = `åŒæ­¥å®Œæˆ, æ–°å¢ž ${totalInserted} æ¡`;
            this.updateProgress((p) => { p.phase = 'done'; p.message = msg; });
            return { ok: true, error: null, inserted: totalInserted, pages: pages, partial: false, failedPages: 0 };
        }
        catch (e) {
