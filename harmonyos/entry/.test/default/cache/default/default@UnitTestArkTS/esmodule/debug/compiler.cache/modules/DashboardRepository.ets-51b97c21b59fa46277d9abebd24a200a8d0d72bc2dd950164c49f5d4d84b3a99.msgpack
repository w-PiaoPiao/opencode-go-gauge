                await this.syncDao.updateSyncStateAndTotals(accountId, 'error', msg, 0);
                this.updateProgress((p) => { p.phase = 'error'; p.message = msg; });
                return { ok: false, error: e.message, inserted: 0, pages: 0, partial: false, failedPages: 0 };
            }
