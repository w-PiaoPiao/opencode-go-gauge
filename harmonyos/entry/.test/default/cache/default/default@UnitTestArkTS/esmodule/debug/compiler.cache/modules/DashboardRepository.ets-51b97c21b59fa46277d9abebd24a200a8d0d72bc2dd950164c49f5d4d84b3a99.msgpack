    async loginSuccess(token, workspaceHint, mode) {
        if (mode === 'add') {
            await this.syncDao.addAccount(token, workspaceHint, true);
        }
        else {
            await this.syncDao.saveToken(token, workspaceHint.trim().length > 0 ? workspaceHint.trim() : 'Default');
        }
